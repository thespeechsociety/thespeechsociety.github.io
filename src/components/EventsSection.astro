---
import { eventsData } from '../data/events';

const categories = ["All", ...Array.from(new Set(eventsData.map(e => e.category)))];
---

<section id="events" class="py-20 relative z-10 border-t border-gray-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-50 border border-brand-200 text-brand-700 text-xs font-semibold uppercase tracking-wider mb-3">
          Events Calendar
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-extrabold text-gray-900 tracking-tight">
          Events of TSS
        </h2>
        <p class="mt-2 text-sm sm:text-base text-gray-600 max-w-xl">
          Dive into our lively, engaging, and knowledge-packed hackathons, tech talks, debate championships, and litfests.
        </p>
      </div>

      <a
        href="/events"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-xs font-semibold bg-white border border-gray-200 text-gray-700 hover:text-gray-900 hover:border-brand-500/40 hover:bg-gray-50 transition-colors self-start md:self-auto shadow-xs"
      >
        <span>View Full Archive</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

    <!-- Category Filter Tabs -->
    <div class="flex items-center gap-2 overflow-x-auto pb-4 mb-8 scrollbar-none" id="event-filters">
      {categories.map((cat, index) => (
        <button
          type="button"
          data-filter={cat}
          class={`event-filter-btn px-4 py-2 rounded-xl text-xs font-medium whitespace-nowrap transition-all duration-200 ${
            index === 0
              ? 'bg-gray-900 text-white font-semibold shadow-xs'
              : 'bg-white text-gray-600 border border-gray-200 hover:text-gray-900 hover:border-gray-300 shadow-xs'
          }`}
        >
          {cat}
        </button>
      ))}
    </div>

    <!-- Events Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="events-grid">
      {eventsData.map((event) => (
        <div
          data-category={event.category}
          class="event-card group rounded-3xl bg-white border border-gray-200 shadow-xs overflow-hidden flex flex-col justify-between hover:border-brand-500/40 hover:shadow-md transition-all duration-300 hover:-translate-y-1"
        >
          <div>
            <!-- Image Header -->
            <div class="relative aspect-[16/10] overflow-hidden bg-gray-100">
              <img
                src={event.image}
                alt={event.title}
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-white/40 via-transparent to-transparent opacity-80"></div>
              
              <!-- Date Badge -->
              <div class="absolute top-4 left-4 px-3 py-1 rounded-full bg-white/90 backdrop-blur-md border border-gray-200 text-[11px] font-semibold text-gray-800 shadow-sm">
                {event.date}
              </div>

              <!-- Category Tag -->
              <div class="absolute bottom-3 left-4 px-2.5 py-0.5 rounded-md bg-brand-600 text-[10px] font-semibold text-white tracking-wide uppercase">
                {event.category}
              </div>
            </div>

            <!-- Content -->
            <div class="p-6">
              <h3 class="text-xl font-display font-bold text-gray-900 tracking-tight mb-3 group-hover:text-brand-600 transition-colors">
                {event.title}
              </h3>
              <p class="text-xs text-gray-600 leading-relaxed line-clamp-4">
                {event.description}
              </p>
            </div>
          </div>

          <!-- Card Footer -->
          <div class="px-6 pb-6 pt-2 border-t border-gray-100 mt-auto">
            <a
              href={event.galleryUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-xs font-semibold text-brand-600 hover:text-brand-700 transition-colors group/link"
            >
              <span>Pictures & Videos Library</span>
              <svg class="w-3.5 h-3.5 group-hover/link:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  const filterButtons = document.querySelectorAll('.event-filter-btn');
  const eventCards = document.querySelectorAll('.event-card');

  filterButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const selected = btn.getAttribute('data-filter');

      // Update active button classes
      filterButtons.forEach(b => {
        b.classList.remove('bg-gray-900', 'text-white', 'font-semibold');
        b.classList.add('bg-white', 'text-gray-600', 'border', 'border-gray-200');
      });
      btn.classList.remove('bg-white', 'text-gray-600', 'border', 'border-gray-200');
      btn.classList.add('bg-gray-900', 'text-white', 'font-semibold');

      // Filter cards
      eventCards.forEach(card => {
        const category = card.getAttribute('data-category');
        if (selected === 'All' || category === selected) {
          (card as HTMLElement).style.display = 'flex';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>

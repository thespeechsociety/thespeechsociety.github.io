---
import { societyInfo } from '../data/society';
import { Image } from 'astro:assets';
import mainLogo from '../assets/img/main logo.png';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const currentYear = new Date().getFullYear();
---

<footer id="footer" class="bg-slate-100/70 border-t border-gray-200 mt-24 relative z-10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-12 lg:gap-8">
      
      <!-- Col 1: Brand & Tagline -->
      <div class="lg:col-span-2 space-y-4">
        <a href={base} class="inline-block" aria-label="The Speech Society">
          <Image
            src={mainLogo}
            alt="The Speech Society Logo"
            class="h-16 sm:h-20 md:h-24 w-auto object-contain"
            loading="lazy"
          />
        </a>

        <p class="text-sm text-gray-600 max-w-sm leading-relaxed">
          Think. Script. Speak. Fostering communication excellence, debating prowess, and leadership across campus and beyond.
        </p>

        <!-- Social Media Icons -->
        <div class="flex items-center gap-2 pt-2">
          <a
            href={societyInfo.links.instagram}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            class="w-9 h-9 rounded-xl bg-white border border-gray-200 shadow-xs flex items-center justify-center text-gray-500 hover:text-pink-600 hover:border-pink-300 hover:bg-pink-50/50 transition-colors"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>

          <a
            href={societyInfo.links.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="w-9 h-9 rounded-xl bg-white border border-gray-200 shadow-xs flex items-center justify-center text-gray-500 hover:text-blue-600 hover:border-blue-300 hover:bg-blue-50/50 transition-colors"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
          </a>

          <a
            href={societyInfo.links.twitter}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Twitter"
            class="w-9 h-9 rounded-xl bg-white border border-gray-200 shadow-xs flex items-center justify-center text-gray-500 hover:text-sky-600 hover:border-sky-300 hover:bg-sky-50/50 transition-colors"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/>
            </svg>
          </a>

          <a
            href={societyInfo.links.facebook}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook"
            class="w-9 h-9 rounded-xl bg-white border border-gray-200 shadow-xs flex items-center justify-center text-gray-500 hover:text-blue-700 hover:border-blue-300 hover:bg-blue-50/50 transition-colors"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M9 8H6v4h3v12h5V12h3.642L18 8h-4V6.333C14 5.374 14.5 5 15.5 5H18V0h-3.808C10.592 0 9 1.592 9 4.715V8z"/>
            </svg>
          </a>

          <a
            href={societyInfo.links.linktree}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Linktree"
            class="w-9 h-9 rounded-xl bg-white border border-gray-200 shadow-xs flex items-center justify-center text-gray-600 hover:text-emerald-700 hover:border-emerald-300 hover:bg-emerald-50/50 transition-colors text-xs font-bold"
          >
            <span class="text-[10px]">LT</span>
          </a>
        </div>
      </div>

      <!-- Col 2: Quick Links -->
      <div class="space-y-3">
        <h4 class="text-xs font-semibold text-gray-900 uppercase tracking-wider">Navigation</h4>
        <ul class="space-y-2 text-sm">
          <li><a href={`${base}#about`} class="text-gray-600 hover:text-gray-900 transition-colors">About TSS</a></li>
          <li><a href={`${base}#events`} class="text-gray-600 hover:text-gray-900 transition-colors">Past & Upcoming Events</a></li>
          <li><a href={`${base}#activities`} class="text-gray-600 hover:text-gray-900 transition-colors">Society Activities</a></li>
          <li><a href={`${base}blog`} class="text-gray-600 hover:text-gray-900 transition-colors">Official Blogs</a></li>
          <li><a href={`${base}team`} class="text-gray-600 hover:text-gray-900 transition-colors">Team Members</a></li>
        </ul>
      </div>

      <!-- Col 3: Community & Join -->
      <div class="space-y-3">
        <h4 class="text-xs font-semibold text-gray-900 uppercase tracking-wider">Get Involved</h4>
        <ul class="space-y-2 text-sm">
          <li>
            <a href={societyInfo.links.inductionForm} target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-brand-600 transition-colors">
              Induction Event 2026
            </a>
          </li>
          <li>
            <a href={societyInfo.links.joinTeam} target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-brand-600 transition-colors">
              Join Core Team Form
            </a>
          </li>
          <li>
            <a href={societyInfo.links.whatsappCommunity} target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-brand-600 transition-colors">
              WhatsApp Community
            </a>
          </li>
          <li>
            <a href={`${base}#testimonials`} class="text-gray-600 hover:text-gray-900 transition-colors">
              Guest Testimonials
            </a>
          </li>
          <li>
            <a href={`${base}#faq`} class="text-gray-600 hover:text-gray-900 transition-colors">
              Frequently Asked Questions
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Campus Contact -->
      <div class="space-y-3">
        <h4 class="text-xs font-semibold text-gray-900 uppercase tracking-wider">Campus Location</h4>
        <p class="text-xs text-gray-600 leading-relaxed">
          {societyInfo.university}<br />
          {societyInfo.campusAddress}
        </p>
        <div class="pt-1 space-y-1 text-xs text-gray-700">
          <p><span class="text-gray-500">Phone:</span> <a href={`tel:${societyInfo.phone}`} class="hover:text-brand-600">{societyInfo.phone}</a></p>
          <p><span class="text-gray-500">Email:</span> <a href={`mailto:${societyInfo.email}`} class="hover:text-brand-600">{societyInfo.email}</a></p>
        </div>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-8 border-t border-gray-200 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-gray-500">
      <p>© {currentYear} The Speech Society (TSS), UEM Jaipur. All rights reserved.</p>
      <div class="flex items-center gap-4">
        <a
          href={`${base}webdev`}
          class="hover:text-brand-600 transition-colors font-medium underline underline-offset-4"
        >
          Designed by Web Dev Team & Contributors at TSS, UEMJ
        </a>
      </div>
    </div>
  </div>
</footer>

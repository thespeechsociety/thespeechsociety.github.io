---
import { testimonials } from '../data/testimonials';
---

<section id="testimonials" class="py-20 relative z-10 border-t border-gray-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-2xl mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-50 border border-brand-200 text-brand-700 text-xs font-semibold uppercase tracking-wider mb-3">
        Testimonials
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-extrabold text-gray-900 tracking-tight">
        Unveiling Perspectives
      </h2>
      <p class="mt-3 text-base text-gray-600">
        Insights and feedback from distinguished dignitaries, keynote speakers, mentors, and industry leaders.
      </p>
    </div>

    <!-- Testimonials Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {testimonials.map((t) => (
        <div class="p-6 sm:p-8 rounded-3xl bg-white border border-gray-200 shadow-xs flex flex-col justify-between hover:border-brand-500/40 hover:shadow-md transition-all duration-300 group">
          
          <div>
            <!-- Header: Avatar + Info + Social -->
            <div class="flex items-start justify-between gap-4 mb-6">
              <div class="flex items-center gap-3">
                <img
                  src={t.image}
                  alt={t.name}
                  loading="lazy"
                  class="w-12 h-12 rounded-2xl object-cover border border-gray-200"
                />
                <div>
                  <h3 class="font-display font-bold text-gray-900 text-base tracking-tight">{t.name}</h3>
                  <p class="text-xs text-gray-500 line-clamp-1">{t.role}</p>
                </div>
              </div>

              <!-- Social Links -->
              <div class="flex items-center gap-1.5 shrink-0">
                {t.social?.linkedin && (
                  <a
                    href={t.social.linkedin}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${t.name} LinkedIn`}
                    class="p-1.5 rounded-lg text-gray-400 hover:text-gray-700 hover:bg-gray-100 transition-colors"
                  >
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                    </svg>
                  </a>
                )}
                {t.social?.instagram && (
                  <a
                    href={t.social.instagram}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${t.name} Instagram`}
                    class="p-1.5 rounded-lg text-gray-400 hover:text-gray-700 hover:bg-gray-100 transition-colors"
                  >
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                    </svg>
                  </a>
                )}
              </div>
            </div>

            <!-- Quote Body -->
            <div class="space-y-3">
              <svg class="w-6 h-6 text-brand-500/30" fill="currentColor" viewBox="0 0 24 24">
                <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
              </svg>
              
              <p class="text-xs sm:text-sm text-gray-700 leading-relaxed font-normal">
                {t.shortQuote}
              </p>
            </div>
          </div>

          <!-- Read More Expandable Trigger -->
          {t.fullQuote !== t.shortQuote && (
            <div class="mt-6 pt-4 border-t border-gray-100">
              <button
                type="button"
                data-testimonial-id={t.id}
                class="testimonial-modal-trigger text-xs font-semibold text-brand-600 hover:text-brand-700 transition-colors flex items-center gap-1"
              >
                <span>Read Full Remarks</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </button>
            </div>
          )}

        </div>
      ))}
    </div>

  </div>

  <!-- Modal Container for Full Remarks -->
  <div id="testimonial-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50 backdrop-blur-sm hidden opacity-0 transition-opacity duration-300">
    <div class="bg-white border border-gray-200 rounded-3xl max-w-lg w-full p-6 sm:p-8 max-h-[85vh] overflow-y-auto shadow-2xl relative">
      <button id="modal-close" aria-label="Close modal" class="absolute top-5 right-5 p-2 rounded-xl text-gray-400 hover:text-gray-700 hover:bg-gray-100 transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <div class="flex items-center gap-4 mb-6">
        <img id="modal-avatar" src="" alt="" class="w-14 h-14 rounded-2xl object-cover border border-gray-200" />
        <div>
          <h3 id="modal-name" class="font-display font-bold text-gray-900 text-lg"></h3>
          <p id="modal-role" class="text-xs text-brand-600 font-medium"></p>
        </div>
      </div>

      <div class="text-sm text-gray-700 leading-relaxed whitespace-pre-line" id="modal-quote"></div>
    </div>
  </div>
</section>

<script>
  import { testimonials } from '../data/testimonials';

  const modal = document.getElementById('testimonial-modal');
  const modalClose = document.getElementById('modal-close');
  const modalAvatar = document.getElementById('modal-avatar') as HTMLImageElement;
  const modalName = document.getElementById('modal-name');
  const modalRole = document.getElementById('modal-role');
  const modalQuote = document.getElementById('modal-quote');
  const triggers = document.querySelectorAll('.testimonial-modal-trigger');

  const openModal = (id: string) => {
    const item = testimonials.find(t => t.id === id);
    if (!item || !modal || !modalAvatar || !modalName || !modalRole || !modalQuote) return;

    modalAvatar.src = item.image;
    modalAvatar.alt = item.name;
    modalName.textContent = item.name;
    modalRole.textContent = item.role;
    modalQuote.textContent = item.fullQuote;

    modal.classList.remove('hidden');
    setTimeout(() => {
      modal.classList.remove('opacity-0');
    }, 10);
  };

  const closeModal = () => {
    if (!modal) return;
    modal.classList.add('opacity-0');
    setTimeout(() => {
      modal.classList.add('hidden');
    }, 300);
  };

  triggers.forEach(trig => {
    trig.addEventListener('click', () => {
      const id = trig.getAttribute('data-testimonial-id');
      if (id) openModal(id);
    });
  });

  modalClose?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });
</script>

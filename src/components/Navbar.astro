---
import { societyInfo } from '../data/society';
import { Image } from 'astro:assets';
import mainLogo from '../assets/img/main logo.png';

const navLinks = [
  { href: '/#about', label: 'About' },
  { href: '/#events', label: 'Events' },
  { href: '/#activities', label: 'Activities' },
  { href: '/blog', label: 'Blogs' },
  { href: '/team', label: 'Team' },
  { href: '/#testimonials', label: 'Testimonials' },
  { href: '/#faq', label: 'FAQ' },
  { href: '/#contact', label: 'Contact' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 py-4 px-4 sm:px-8" id="site-header">
  <div class="max-w-7xl mx-auto flex items-center justify-between px-4 py-2.5 rounded-2xl bg-white/85 backdrop-blur-xl border border-gray-200 shadow-md">
    <!-- Logo -->
    <a href="/" class="flex items-center group py-0.5" aria-label="The Speech Society">
      <Image
        src={mainLogo}
        alt="The Speech Society"
        class="h-14 sm:h-16 md:h-20 w-auto object-contain transition-transform duration-200 group-hover:scale-[1.02]"
        loading="eager"
      />
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden lg:flex items-center gap-1.5">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="px-3.5 py-2 rounded-xl text-sm xl:text-base font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-100/80 transition-all duration-200"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Desktop Actions -->
    <div class="hidden sm:flex items-center gap-3">
      <a
        href="/induction"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold bg-gray-900 text-white hover:bg-gray-800 transition-all duration-200 shadow-xs"
      >
        <span>Induction 2026</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

    <!-- Mobile Menu Toggle Button -->
    <button
      id="mobile-menu-btn"
      type="button"
      aria-label="Toggle navigation menu"
      class="lg:hidden p-2 rounded-xl text-gray-600 hover:text-gray-900 hover:bg-gray-100 transition-colors focus:outline-none"
    >
      <svg class="w-6 h-6" id="menu-icon-open" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg class="w-6 h-6 hidden" id="menu-icon-close" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden max-w-7xl mx-auto mt-2 p-4 rounded-2xl bg-white/95 backdrop-blur-2xl border border-gray-200 shadow-2xl transition-all duration-300"
  >
    <nav class="flex flex-col gap-1.5">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="mobile-nav-link px-4 py-3 rounded-xl text-base font-medium text-gray-700 hover:text-gray-900 hover:bg-gray-100 transition-colors"
        >
          {link.label}
        </a>
      ))}
      <div class="pt-3 mt-2 border-t border-gray-200 flex flex-col gap-2">
        <a
          href="/induction"
          class="w-full text-center px-4 py-3 rounded-xl text-base font-semibold bg-gray-900 text-white hover:bg-gray-800 transition-colors"
        >
          Induction Event 2026
        </a>
        <a
          href={societyInfo.links.whatsappCommunity}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full text-center px-4 py-3 rounded-xl text-base font-semibold bg-gray-50 border border-gray-200 text-gray-800 hover:text-black hover:border-brand-500/40 hover:bg-gray-100 transition-colors"
        >
          Join Community
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');
  const links = document.querySelectorAll('.mobile-nav-link');

  if (btn && menu && iconOpen && iconClose) {
    btn.addEventListener('click', () => {
      const isExpanded = !menu.classList.contains('hidden');
      if (isExpanded) {
        menu.classList.add('hidden');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
      } else {
        menu.classList.remove('hidden');
        iconOpen.classList.add('hidden');
        iconClose.classList.remove('hidden');
      }
    });

    links.forEach((link) => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
      });
    });
  }
</script>

---
import { societyInfo } from '../data/society';
---

<section id="hero" class="relative pt-32 pb-16 md:pt-40 md:pb-24 overflow-hidden">
  
  <!-- Ambient Soft Gradients (Inspired by Amplemarket design) -->
  <div class="absolute -top-12 -left-20 w-[450px] h-[450px] bg-orange-200/40 blur-[120px] rounded-full pointer-events-none -z-10"></div>
  <div class="absolute top-1/4 -right-16 w-[500px] h-[500px] bg-purple-200/35 blur-[140px] rounded-full pointer-events-none -z-10"></div>
  <div class="absolute top-1/2 left-1/3 -translate-x-1/2 w-[600px] h-[300px] bg-blue-100/30 blur-[130px] rounded-full pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
    
    <!-- Top Pill Notification Badge -->
    <a
      href="/induction"
      class="inline-flex items-center gap-2 p-1 pr-4 rounded-full bg-white/90 border border-gray-200 shadow-xs hover:border-gray-300 hover:shadow-sm transition-all duration-200 mb-8 group"
    >
      <span class="px-2.5 py-0.5 rounded-full bg-gray-950 text-white text-[10px] font-bold tracking-wider uppercase">
        NEW
      </span>
      <span class="text-xs font-medium text-gray-700 group-hover:text-gray-950 transition-colors flex items-center gap-1">
        <span>Inductions 2026 Registrations are now live</span>
        <span class="group-hover:translate-x-0.5 transition-transform">→</span>
      </span>
    </a>

    <!-- Headline (with 3-line alignment and signature serif italic styling) -->
    <h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-[82px] font-display font-extrabold text-gray-950 tracking-tight leading-[1.1] max-w-4xl mx-auto mb-6">
      <span class="block">Step <span class="font-serif italic font-normal text-gray-900">into</span> the arena</span>
      <span class="block"><span class="font-serif italic font-normal text-gray-900">of</span> speech:</span>
      <span class="block">Mind + Voice</span>
    </h1>

    <!-- Subtitle -->
    <p class="max-w-xl mx-auto text-base sm:text-lg text-gray-600 font-normal leading-relaxed mb-8">
      Empower your voice, master stage presence, and command public debates with UEM Jaipur's premier communication society.
    </p>

    <!-- Email Input / Quick Action Bar -->
    <div class="max-w-md mx-auto mb-5">
      <form
        id="hero-email-form"
        class="relative flex items-center p-1.5 rounded-2xl bg-white border border-gray-300/90 shadow-md focus-within:border-gray-900 focus-within:ring-2 focus-within:ring-gray-900/10 transition-all"
      >
        <input
          type="email"
          id="hero-email-input"
          required
          placeholder="Enter your student email..."
          class="w-full pl-4 pr-36 py-2.5 bg-transparent text-sm text-gray-900 placeholder-gray-400 focus:outline-none"
        />
        <button
          type="submit"
          class="absolute right-1.5 px-5 py-2.5 rounded-xl bg-gray-900 hover:bg-gray-800 text-white text-xs font-semibold shadow-sm transition-all duration-200 flex items-center gap-1 hover:scale-[1.02]"
        >
          <span>Join #teamtss</span>
        </button>
      </form>
    </div>

    <!-- Rating / Social Proof Row -->
    <div class="flex flex-wrap items-center justify-center gap-3 text-xs text-gray-600 mb-14">
      <div class="flex items-center gap-1.5">
        <svg class="w-4 h-4 text-emerald-600" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
        </svg>
        <div class="flex text-amber-500 text-sm tracking-tighter">
          ★★★★★
        </div>
      </div>
      <span class="text-gray-300">•</span>
      <span class="text-gray-600 font-medium">
        Rated 4.9/5 by 500+ student debaters & speakers
      </span>
      <span class="text-gray-300">•</span>
      <span class="text-gray-500">Official Body of <strong class="text-gray-800">UEM Jaipur</strong></span>
    </div>

    <!-- Hero Mockup & Clean Side Rocket Layout -->
    <div class="relative max-w-5xl mx-auto">
      
      <!-- Hand-Drawn Hero Rocket Illustration (src/assets/img/herosectionimg.png with floating flight animation) -->
      <div class="block absolute -right-2 sm:-right-6 md:-right-8 xl:-right-24 -top-16 sm:-top-28 md:-top-36 xl:-top-48 w-32 sm:w-56 md:w-80 lg:w-[380px] xl:w-[440px] pointer-events-none z-20 select-none animate-float-rocket">
        <!-- Purple ambient glow under rocket with thruster pulse -->
        <div class="absolute bottom-4 left-4 sm:bottom-10 sm:left-8 w-20 h-20 sm:w-44 sm:h-44 bg-purple-500/35 blur-2xl sm:blur-3xl rounded-full pointer-events-none animate-thruster-glow"></div>
        <img
          src="/assets/img/herosectionimg.png"
          alt="The Speech Society Rocket Launch"
          class="w-full h-auto object-contain drop-shadow-lg relative z-10 transition-transform duration-500 hover:scale-105"
        />
      </div>

      <!-- Video Showcase Container -->
      <div class="relative rounded-3xl bg-black border border-gray-200/90 shadow-2xl overflow-hidden transition-all duration-300 hover:shadow-3xl">
        <div class="relative w-full aspect-video bg-black overflow-hidden flex items-center justify-center">
          <video
            src="/assets/video/herosection-video.mp4"
            autoplay
            loop
            muted
            playsinline
            preload="auto"
            class="w-full h-full object-cover"
          >
            <source src="/assets/video/herosection-video.mp4" type="video/mp4" />
            <source src="/assets/video/herosection video.mp4" type="video/mp4" />
            Your browser does not support the video tag.
          </video>
        </div>
      </div>

    </div>

  </div>
</section>

<script>
  const emailForm = document.getElementById('hero-email-form') as HTMLFormElement;
  const emailInput = document.getElementById('hero-email-input') as HTMLInputElement;

  emailForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const email = emailInput?.value?.trim();
    if (email) {
      window.open('https://thespeechsociety.github.io/induction', '_blank');
      emailInput.value = '';
      alert('Thank you! Redirecting you to The Speech Society official registration.');
    }
  });
</script>

<style>
  @keyframes floatRocket {
    0%, 100% {
      transform: translateY(0px) translateX(0px) rotate(0deg);
    }
    25% {
      transform: translateY(-10px) translateX(5px) rotate(1.5deg);
    }
    50% {
      transform: translateY(-20px) translateX(2px) rotate(-1deg);
    }
    75% {
      transform: translateY(-8px) translateX(-4px) rotate(1deg);
    }
  }

  @keyframes thrusterPulse {
    0%, 100% {
      transform: scale(1);
      opacity: 0.35;
    }
    50% {
      transform: scale(1.4);
      opacity: 0.75;
    }
  }

  .animate-float-rocket {
    animation: floatRocket 6s ease-in-out infinite;
    will-change: transform;
  }

  .animate-thruster-glow {
    animation: thrusterPulse 3s ease-in-out infinite;
    will-change: transform, opacity;
  }
</style>

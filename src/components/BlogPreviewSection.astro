---
import { blogsData } from '../data/blogs';

const previewBlogs = blogsData.slice(0, 3);
---

<section id="blogs" class="py-20 relative z-10 border-t border-gray-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-50 border border-brand-200 text-brand-700 text-xs font-semibold uppercase tracking-wider mb-3">
          TSS Blogosphere
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-extrabold text-gray-900 tracking-tight">
          Featured Articles
        </h2>
        <p class="mt-2 text-sm sm:text-base text-gray-600 max-w-xl">
          Embark on a journey of inspiration through stories, event recaps, speaker insights, and speech masterclasses.
        </p>
      </div>

      <a
        href="/blog"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-xs font-semibold bg-white border border-gray-200 text-gray-700 hover:text-gray-900 hover:border-brand-500/40 hover:bg-gray-50 transition-colors self-start md:self-auto shadow-xs"
      >
        <span>View All Blogs</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

    <!-- Blog Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {previewBlogs.map((blog) => (
        <article class="group rounded-3xl bg-white border border-gray-200 shadow-xs overflow-hidden flex flex-col justify-between hover:border-brand-500/40 hover:shadow-md transition-all duration-300 hover:-translate-y-1">
          <div>
            <!-- Image Header -->
            <a href={`/blog/${blog.slug}`} class="block relative aspect-[16/10] overflow-hidden bg-gray-100">
              <img
                src={blog.image}
                alt={blog.title}
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-white/40 via-transparent to-transparent opacity-70"></div>
              
              <div class="absolute top-4 left-4 px-3 py-1 rounded-full bg-white/90 backdrop-blur-md border border-gray-200 text-[11px] font-semibold text-gray-800 shadow-sm">
                {blog.date}
              </div>
            </a>

            <!-- Body -->
            <div class="p-6">
              <h3 class="text-lg sm:text-xl font-display font-bold text-gray-900 tracking-tight mb-2 group-hover:text-brand-600 transition-colors">
                <a href={`/blog/${blog.slug}`}>
                  {blog.title}
                </a>
              </h3>

              <p class="text-xs text-gray-600 leading-relaxed line-clamp-3 mb-6">
                {blog.summary}
              </p>
            </div>
          </div>

          <!-- Footer with Authors -->
          <div class="px-6 pb-6 pt-4 border-t border-gray-100 flex items-center justify-between mt-auto">
            <div class="flex items-center gap-2">
              <div class="flex -space-x-2 overflow-hidden">
                {blog.authors.map((author) => (
                  <img
                    src={author.image}
                    alt={author.name}
                    class="inline-block h-7 w-7 rounded-full ring-2 ring-white object-cover"
                  />
                ))}
              </div>
              <span class="text-xs text-gray-600 truncate max-w-[130px]">
                {blog.authors.map(a => a.name).join(', ')}
              </span>
            </div>

            <a
              href={`/blog/${blog.slug}`}
              class="inline-flex items-center gap-1.5 text-xs font-semibold text-brand-600 hover:text-brand-700 transition-colors"
            >
              <span>Read</span>
              <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>

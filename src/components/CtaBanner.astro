---
import { societyInfo } from '../data/society';
---

<section id="cta" class="py-16 relative z-10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="relative rounded-3xl bg-gradient-to-br from-blue-50 via-white to-indigo-50/60 border border-brand-200 p-8 sm:p-12 lg:p-16 overflow-hidden text-center shadow-lg">
      
      <!-- Ambient Glow in banner -->
      <div class="absolute -top-24 -left-24 w-72 h-72 bg-brand-500/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-24 -right-24 w-72 h-72 bg-purple-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 max-w-2xl mx-auto space-y-6">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-brand-100 border border-brand-200 text-brand-800 text-xs font-semibold uppercase tracking-wider">
          Be a part of #teamtss
        </div>

        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-extrabold text-gray-900 tracking-tight leading-tight">
          Ready to Amplify Your Voice?
        </h2>

        <p class="text-sm sm:text-base text-gray-600 leading-relaxed">
          Whether you want to lead discussions, master public debates, coordinate mega litfests, design visuals, or develop the web platforms, there is a place for you in The Speech Society.
        </p>

        <div class="flex flex-wrap items-center justify-center gap-4 pt-4">
          <a
            href={societyInfo.links.joinTeam}
            target="_blank"
            rel="noopener noreferrer"
            class="px-8 py-3.5 rounded-xl text-sm font-bold bg-gray-900 text-white hover:bg-gray-800 transition-all duration-200 shadow-lg hover:scale-[1.02]"
          >
            Join Team TSS (Core Application)
          </a>

          <a
            href={societyInfo.links.whatsappCommunity}
            target="_blank"
            rel="noopener noreferrer"
            class="px-8 py-3.5 rounded-xl text-sm font-bold bg-white border border-gray-300 text-gray-800 hover:text-black hover:border-brand-500 hover:bg-gray-50 shadow-sm transition-all duration-200"
          >
            Join WhatsApp Community
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

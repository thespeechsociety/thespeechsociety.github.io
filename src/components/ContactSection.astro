---
import { societyInfo } from '../data/society';
---

<section id="contact" class="py-20 relative z-10 border-t border-gray-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-2xl mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-50 border border-brand-200 text-brand-700 text-xs font-semibold uppercase tracking-wider mb-3">
        Get in Touch
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-extrabold text-gray-900 tracking-tight">
        Contact Us
      </h2>
      <p class="mt-3 text-base text-gray-600">
        Have questions about auditions, upcoming events, or club collaborations? Reach out directly.
      </p>
    </div>

    <!-- Contact Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      
      <!-- Left 5 cols: Info & Map -->
      <div class="lg:col-span-5 space-y-6 flex flex-col justify-between">
        
        <div class="space-y-4">
          <!-- Address Card -->
          <div class="p-6 rounded-2xl bg-white border border-gray-200 shadow-xs hover:border-brand-500/40 hover:shadow-sm transition-all flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-brand-50 border border-brand-200 text-brand-600 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <h4 class="text-sm font-semibold text-gray-900 mb-1">Campus Location</h4>
              <p class="text-xs text-gray-600 leading-relaxed">
                {societyInfo.university}<br />
                {societyInfo.campusAddress}
              </p>
            </div>
          </div>

          <!-- Email Card -->
          <div class="p-6 rounded-2xl bg-white border border-gray-200 shadow-xs hover:border-brand-500/40 hover:shadow-sm transition-all flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-brand-50 border border-brand-200 text-brand-600 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <h4 class="text-sm font-semibold text-gray-900 mb-1">Email Address</h4>
              <a href={`mailto:${societyInfo.email}`} class="text-xs text-brand-600 hover:underline font-medium">
                {societyInfo.email}
              </a>
            </div>
          </div>

          <!-- Phone Card -->
          <div class="p-6 rounded-2xl bg-white border border-gray-200 shadow-xs hover:border-brand-500/40 hover:shadow-sm transition-all flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-brand-50 border border-brand-200 text-brand-600 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div>
              <h4 class="text-sm font-semibold text-gray-900 mb-1">Phone Number</h4>
              <a href={`tel:${societyInfo.phone}`} class="text-xs text-brand-600 hover:underline font-medium">
                {societyInfo.phone}
              </a>
            </div>
          </div>
        </div>

        <!-- Embedded Map -->
        <div class="rounded-2xl overflow-hidden border border-gray-200 shadow-xs aspect-[16/9] w-full">
          <iframe
            title="UEM Jaipur Location Map"
            style="border: 0; width: 100%; height: 100%;"
            src={societyInfo.links.mapEmbed}
            loading="lazy"
            allowfullscreen
          ></iframe>
        </div>

      </div>

      <!-- Right 7 cols: Interactive Form -->
      <div class="lg:col-span-7">
        <div class="p-8 sm:p-10 rounded-3xl bg-white border border-gray-200 shadow-xl relative">
          <h3 class="text-xl sm:text-2xl font-display font-bold text-gray-900 tracking-tight mb-2">
            Send Us a Message
          </h3>
          <p class="text-xs text-gray-500 mb-8">
            Fill out the form below and our team will get back to you promptly.
          </p>

          <form action={societyInfo.links.formSubmitEndpoint} method="POST" class="space-y-5">
            <input type="text" name="_honey" style="display:none;" />
            <input type="hidden" name="_captcha" value="false" />

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="name" class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-2">
                  Full Name *
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="e.g. Alex Sharma"
                  class="w-full px-4 py-3 rounded-xl bg-gray-50 border border-gray-200 text-sm text-gray-900 placeholder-gray-400 focus:bg-white focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500 transition-all"
                />
              </div>

              <div>
                <label for="email" class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-2">
                  Email Address *
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  placeholder="e.g. alex@example.com"
                  class="w-full px-4 py-3 rounded-xl bg-gray-50 border border-gray-200 text-sm text-gray-900 placeholder-gray-400 focus:bg-white focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500 transition-all"
                />
              </div>
            </div>

            <div>
              <label for="contactnumber" class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-2">
                Contact Number
              </label>
              <input
                type="text"
                id="contactnumber"
                name="contact number"
                placeholder="+91 98765 43210"
                class="w-full px-4 py-3 rounded-xl bg-gray-50 border border-gray-200 text-sm text-gray-900 placeholder-gray-400 focus:bg-white focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500 transition-all"
              />
            </div>

            <div>
              <label for="message" class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-2">
                Your Message *
              </label>
              <textarea
                id="message"
                name="message"
                rows="4"
                required
                placeholder="Tell us about your query, suggestions, or interest in collaborating..."
                class="w-full px-4 py-3 rounded-xl bg-gray-50 border border-gray-200 text-sm text-gray-900 placeholder-gray-400 focus:bg-white focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500 transition-all resize-none"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full py-3.5 px-6 rounded-xl text-sm font-semibold bg-gray-900 text-white hover:bg-gray-800 transition-colors shadow-lg"
            >
              Send Message
            </button>
          </form>
        </div>
      </div>

    </div>

  </div>
</section>

---
interface Props {
  className?: string;
}

const { className = "" } = Astro.props;
---

<div class={`w-full mb-8 sm:mb-10 ${className}`}>
  <div class="relative rounded-2xl bg-gradient-to-r from-blue-50/90 via-purple-50/80 to-blue-50/90 border border-blue-200/80 px-4 py-3 sm:py-3.5 shadow-xs text-center overflow-hidden transition-all duration-300">
    <div class="flex flex-wrap items-center justify-center gap-1.5 sm:gap-2 text-xs sm:text-sm font-medium text-gray-700 leading-normal">
      <span class="inline-flex items-center gap-1.5 text-purple-700 font-semibold">
        <span class="text-purple-600 font-bold">✦</span>
        <span>Build smarter with AI</span>
      </span>
      <span class="hidden sm:inline text-gray-400">—</span>
      <span class="text-gray-600">Explore</span>
      <a
        href="https://gigpilotai.com/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 font-bold text-brand-700 hover:text-brand-900 underline underline-offset-4 decoration-brand-400 hover:decoration-brand-700 transition-colors focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-1 rounded px-1 py-0.5"
      >
        <span>GigPilot AI</span>
        <svg class="w-3.5 h-3.5 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>
</div>

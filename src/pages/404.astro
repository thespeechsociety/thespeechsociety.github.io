---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="404 - Page Not Found | The Speech Society (TSS)"
  description="Oops! The page you are looking for does not exist or has been moved. Return to The Speech Society homepage."
>
  <div class="min-h-[80vh] flex items-center justify-center pt-36 pb-24 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
    <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-96 h-96 bg-brand-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -right-24 w-80 h-80 bg-purple-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="text-center max-w-lg mx-auto relative z-10 space-y-6">
      
      <!-- Error Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-50 border border-brand-200 text-brand-700 text-xs font-semibold uppercase tracking-wider">
        <span class="w-2 h-2 rounded-full bg-brand-600 animate-pulse"></span>
        <span>Error 404 • Page Not Found</span>
      </div>

      <!-- Large 404 Display -->
      <div class="relative py-2">
        <span class="text-8xl sm:text-9xl font-display font-extrabold text-transparent bg-clip-text bg-gradient-to-br from-brand-600 via-purple-600 to-gray-900 tracking-tight select-none">
          404
        </span>
      </div>

      <h1 class="text-2xl sm:text-3xl font-display font-extrabold text-gray-900 tracking-tight">
        Lost in Thought?
      </h1>

      <p class="text-sm sm:text-base text-gray-600 leading-relaxed max-w-md mx-auto">
        The page you are looking for might have been moved, renamed, or no longer exists. Let's get you back on stage.
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-3 pt-4">
        <a
          href="/"
          class="px-7 py-3.5 rounded-xl text-sm font-bold bg-gray-900 text-white hover:bg-gray-800 transition-all duration-200 shadow-md hover:scale-[1.02] flex items-center gap-2"
        >
          <span>Return Home</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
        </a>

        <a
          href="/induction"
          class="px-6 py-3.5 rounded-xl text-sm font-bold bg-brand-50 border border-brand-200 text-brand-700 hover:bg-brand-100 transition-all duration-200 shadow-xs"
        >
          Induction 2026
        </a>

        <a
          href="/events"
          class="px-6 py-3.5 rounded-xl text-sm font-semibold bg-white border border-gray-200 text-gray-800 hover:text-black hover:border-gray-300 hover:bg-gray-50 transition-all duration-200 shadow-xs"
        >
          Explore Events
        </a>
      </div>

    </div>
  </div>
</Layout>

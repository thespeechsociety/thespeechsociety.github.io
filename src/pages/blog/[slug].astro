---
import Layout from '../../layouts/Layout.astro';
import { blogsData, type BlogPost } from '../../data/blogs';

export function getStaticPaths() {
  return blogsData.map((blog) => ({
    params: { slug: blog.slug },
    props: { blog },
  }));
}

interface Props {
  blog: BlogPost;
}

const { blog } = Astro.props;
---

<Layout
  title={`${blog.title} | TSS Blog`}
  description={blog.summary}
  image={blog.image}
>
  <article class="pt-32 pb-24 relative z-10">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-2 text-xs text-gray-500 mb-8 overflow-x-auto">
        <a href="/" class="hover:text-gray-900 transition-colors">Home</a>
        <span>/</span>
        <a href="/blog" class="hover:text-gray-900 transition-colors">Blog</a>
        <span>/</span>
        <span class="text-gray-900 font-medium truncate max-w-[200px] sm:max-w-none">{blog.title}</span>
      </nav>

      <!-- Article Header -->
      <header class="mb-10">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-50 border border-brand-200 text-brand-700 text-xs font-semibold uppercase tracking-wider mb-4">
          TSS Article
        </div>
        
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-display font-extrabold text-gray-900 tracking-tight leading-tight mb-6">
          {blog.title}
        </h1>

        <!-- Meta Bar -->
        <div class="flex flex-wrap items-center justify-between gap-4 py-4 border-y border-gray-200 text-xs text-gray-500">
          <div class="flex items-center gap-3">
            <div class="flex -space-x-2">
              {blog.authors.map((a) => (
                <img src={a.image} alt={a.name} class="w-8 h-8 rounded-full ring-2 ring-white object-cover" />
              ))}
            </div>
            <div>
              <span class="text-gray-900 font-medium">{blog.authors.map(a => a.name).join(' & ')}</span>
              <span class="mx-2">•</span>
              <time datetime={blog.dateIso}>{blog.date}</time>
            </div>
          </div>

          <div class="flex items-center gap-2">
            <button
              id="copy-link-btn"
              type="button"
              class="px-3 py-1.5 rounded-lg bg-white border border-gray-200 text-gray-700 hover:text-gray-900 hover:border-brand-500/40 hover:bg-gray-50 transition-colors flex items-center gap-1.5 shadow-xs"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
              <span id="copy-btn-text">Share Article</span>
            </button>
          </div>
        </div>
      </header>

      <!-- Featured Hero Image -->
      <div class="rounded-3xl overflow-hidden border border-gray-200 mb-12 aspect-[16/9] bg-gray-100 relative shadow-lg">
        <img
          src={blog.image}
          alt={blog.title}
          class="w-full h-full object-cover"
        />
      </div>

      <!-- Article Content -->
      <div class="prose prose-slate prose-brand max-w-none text-gray-700 leading-relaxed space-y-6 text-base sm:text-lg">
        <div set:html={blog.contentHtml} />
      </div>

      <!-- Authors Section -->
      <div class="mt-16 pt-12 border-t border-gray-200 space-y-8">
        <h3 class="text-xl font-display font-bold text-gray-900 tracking-tight">About the Authors</h3>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {blog.authors.map((author) => (
            <div class="p-6 rounded-2xl bg-white border border-gray-200 shadow-xs flex flex-col justify-between">
              <div>
                <div class="flex items-center gap-4 mb-4">
                  <img
                    src={author.image}
                    alt={author.name}
                    class="w-14 h-14 rounded-2xl object-cover border border-gray-200"
                  />
                  <div>
                    <h4 class="font-display font-bold text-gray-900 text-base">{author.name}</h4>
                    <p class="text-xs text-brand-600 font-medium">{author.role}</p>
                  </div>
                </div>

                <p class="text-xs text-gray-600 leading-relaxed mb-4">
                  {author.bio}
                </p>
              </div>

              <!-- Social Links -->
              <div class="flex items-center gap-2 pt-2 border-t border-gray-100">
                {author.social.linkedin && (
                  <a
                    href={author.social.linkedin}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${author.name} LinkedIn`}
                    class="p-2 rounded-lg bg-gray-50 border border-gray-200 text-gray-500 hover:text-blue-600 hover:border-blue-300 transition-colors"
                  >
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                    </svg>
                  </a>
                )}
                {author.social.instagram && (
                  <a
                    href={author.social.instagram}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${author.name} Instagram`}
                    class="p-2 rounded-lg bg-gray-50 border border-gray-200 text-gray-500 hover:text-pink-600 hover:border-pink-300 transition-colors"
                  >
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                    </svg>
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Navigation footer back to blog -->
      <div class="mt-12 text-center">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-white border border-gray-200 text-sm font-semibold text-gray-800 hover:text-black hover:border-brand-400 hover:bg-gray-50 shadow-sm transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          <span>Back to All Blogs</span>
        </a>
      </div>

    </div>
  </article>
</Layout>

<script>
  const copyBtn = document.getElementById('copy-link-btn');
  const copyText = document.getElementById('copy-btn-text');

  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(window.location.href);
      if (copyText) {
        copyText.textContent = 'Link Copied!';
        setTimeout(() => {
          copyText.textContent = 'Share Article';
        }, 2000);
      }
    } catch (err) {
      console.error(err);
    }
  });
</script>

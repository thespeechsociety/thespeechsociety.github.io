---
import Layout from '../../layouts/Layout.astro';
import { blogsData } from '../../data/blogs';
---

<Layout
  title="Official Blog | The Speech Society (TSS)"
  description="Read official articles, event chronicles, speech analysis, and thought leadership from The Speech Society at UEM Jaipur."
>
  <div class="pt-32 pb-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Page Header -->
    <div class="max-w-3xl mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-50 border border-brand-200 text-brand-700 text-xs font-semibold uppercase tracking-wider mb-4">
        Editorial
      </div>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-display font-extrabold text-gray-900 tracking-tight leading-tight">
        TSS Blogosphere
      </h1>
      <p class="mt-3 text-base text-gray-600">
        Perspectives on public communication, event memoirs, Toastmasters learnings, and women empowerment.
      </p>
    </div>

    <!-- Blog Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {blogsData.map((blog) => (
        <article class="group rounded-3xl bg-white border border-gray-200 shadow-xs overflow-hidden flex flex-col justify-between hover:border-brand-500/40 hover:shadow-md transition-all duration-300 hover:-translate-y-1">
          <div>
            <!-- Image Header -->
            <a href={`/blog/${blog.slug}`} class="block relative aspect-[16/10] overflow-hidden bg-gray-100">
              <img
                src={blog.image}
                alt={blog.title}
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-white/40 via-transparent to-transparent opacity-80"></div>
              
              <div class="absolute top-4 left-4 px-3 py-1 rounded-full bg-white/90 backdrop-blur-md border border-gray-200 text-[11px] font-semibold text-gray-800 shadow-sm">
                {blog.date}
              </div>
            </a>

            <!-- Content -->
            <div class="p-6">
              <h2 class="text-xl font-display font-bold text-gray-900 tracking-tight mb-2 group-hover:text-brand-600 transition-colors">
                <a href={`/blog/${blog.slug}`}>
                  {blog.title}
                </a>
              </h2>

              <p class="text-xs text-gray-600 leading-relaxed line-clamp-3 mb-6">
                {blog.summary}
              </p>
            </div>
          </div>

          <!-- Footer with Authors -->
          <div class="px-6 pb-6 pt-4 border-t border-gray-100 flex items-center justify-between mt-auto">
            <div class="flex items-center gap-2.5">
              <div class="flex -space-x-2 overflow-hidden">
                {blog.authors.map((author) => (
                  <img
                    src={author.image}
                    alt={author.name}
                    class="inline-block h-8 w-8 rounded-full ring-2 ring-white object-cover"
                  />
                ))}
              </div>
              <div>
                <span class="block text-xs font-semibold text-gray-800 line-clamp-1 max-w-[130px]">
                  {blog.authors.map(a => a.name).join(', ')}
                </span>
                <span class="block text-[10px] text-gray-400 font-medium">Author</span>
              </div>
            </div>

            <a
              href={`/blog/${blog.slug}`}
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-gray-50 border border-gray-200 text-xs font-semibold text-brand-600 hover:text-brand-700 hover:bg-gray-100 hover:border-brand-300 transition-all shadow-xs"
            >
              <span>Read Post</span>
              <svg class="w-3.5 h-3.5 fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>

  </div>
</Layout>

---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="500 - Server Error | The Speech Society (TSS)"
  description="Internal server error. We are experiencing a temporary technical glitch. Please try refreshing or return to the homepage."
>
  <div class="min-h-[80vh] flex items-center justify-center pt-36 pb-24 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
    <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -right-24 w-80 h-80 bg-red-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="text-center max-w-lg mx-auto relative z-10 space-y-6">
      
      <!-- Error Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-50 border border-amber-200 text-amber-800 text-xs font-semibold uppercase tracking-wider">
        <span class="w-2 h-2 rounded-full bg-amber-600 animate-pulse"></span>
        <span>Error 500 • Server Error</span>
      </div>

      <!-- Large 500 Display -->
      <div class="relative py-2">
        <span class="text-8xl sm:text-9xl font-display font-extrabold text-transparent bg-clip-text bg-gradient-to-br from-amber-600 via-brand-600 to-gray-900 tracking-tight select-none">
          500
        </span>
      </div>

      <h1 class="text-2xl sm:text-3xl font-display font-extrabold text-gray-900 tracking-tight">
        Technical Stage Pause
      </h1>

      <p class="text-sm sm:text-base text-gray-600 leading-relaxed max-w-md mx-auto">
        Something unexpected occurred on our servers. Our technical team has been notified and is fixing it.
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-3 pt-4">
        <button
          onclick="window.location.reload()"
          type="button"
          class="px-7 py-3.5 rounded-xl text-sm font-bold bg-gray-900 text-white hover:bg-gray-800 transition-all duration-200 shadow-md hover:scale-[1.02] flex items-center gap-2"
        >
          <span>Refresh Page</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
        </button>

        <a
          href="/"
          class="px-6 py-3.5 rounded-xl text-sm font-semibold bg-white border border-gray-200 text-gray-800 hover:text-black hover:border-gray-300 hover:bg-gray-50 transition-all duration-200 shadow-xs"
        >
          Return Home
        </a>
      </div>

    </div>
  </div>
</Layout>

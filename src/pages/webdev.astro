---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { webDevContributors } from '../data/webdev';
import { societyInfo } from '../data/society';
import contributeImg from '../assets/img/contribute image.png';
---

<Layout
  title="Web Dev Team & Contributors | The Speech Society (TSS)"
  description="Meet the developers, designers, and open-source contributors behind the official web platform of The Speech Society, UEM Jaipur."
>
  <div class="pt-32 pb-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Hero Header with Animated Graphic -->
    <div class="relative flex flex-col lg:flex-row lg:items-center justify-between gap-8 mb-16">
      <div class="max-w-2xl relative z-10">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-50 border border-brand-200 text-brand-700 text-xs font-semibold uppercase tracking-wider mb-4">
          Engineering & Design
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-display font-extrabold text-gray-900 tracking-tight leading-tight">
          Web Dev Team & Contributors
        </h1>
        <p class="mt-4 text-base sm:text-lg text-gray-600 leading-relaxed">
          The developers, designers, and open-source builders who architected, coded, and continuously improved the digital presence of The Speech Society (#teamtss).
        </p>
      </div>

      <!-- Animated Graphic (contribute image.png) -->
      <div class="w-64 sm:w-80 md:w-96 lg:w-[380px] shrink-0 mx-auto lg:mx-0 relative select-none pointer-events-none animate-float-contribute">
        <div class="absolute inset-0 bg-brand-500/15 rounded-full blur-3xl -z-10 animate-pulse-glow"></div>
        <Image
          src={contributeImg}
          alt="Contribute to The Speech Society Web Dev"
          class="w-full h-auto object-contain drop-shadow-2xl"
          loading="eager"
        />
      </div>
    </div>

    <!-- Contributors Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {webDevContributors.map((dev) => (
        <div class="group p-6 rounded-3xl bg-white border border-gray-200 shadow-xs hover:shadow-md hover:border-brand-500/40 transition-all duration-300 flex flex-col justify-between relative overflow-hidden">
          
          <!-- Lead / Special Badge Top Accent -->
          {dev.badge ? (
            <div class="absolute top-0 right-0">
              <span class="inline-flex items-center gap-1 px-3.5 py-1 bg-gradient-to-r from-purple-50 to-brand-50 text-purple-700 border-b border-l border-purple-200/80 text-[10px] font-extrabold uppercase rounded-bl-xl tracking-wider shadow-2xs">
                <span class="w-1.5 h-1.5 rounded-full bg-purple-600 animate-pulse"></span>
                <span>{dev.badge}</span>
              </span>
            </div>
          ) : dev.isLead ? (
            <div class="absolute top-0 right-0">
              <span class="inline-block px-3 py-1 bg-brand-50 text-brand-700 border-b border-l border-brand-200 text-[10px] font-bold uppercase rounded-bl-xl tracking-wider">
                Lead
              </span>
            </div>
          ) : null}

          <div>
            <!-- Avatar & Top Info -->
            <div class="flex items-center gap-4 mb-4">
              <div class="w-16 h-16 rounded-2xl overflow-hidden border border-gray-200 bg-gray-100 shrink-0 group-hover:scale-105 transition-transform duration-300 shadow-xs">
                <img
                  src={dev.avatar}
                  alt={dev.name}
                  loading="lazy"
                  class="w-full h-full object-cover object-top"
                  onerror="this.src='/assets/img/logo.png'"
                />
              </div>

              <div>
                <h3 class="font-display font-bold text-lg text-gray-900 tracking-tight group-hover:text-brand-600 transition-colors">
                  {dev.name}
                </h3>
                <p class="text-xs text-brand-600 font-medium">
                  {dev.role}
                </p>
                <a
                  href={dev.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 text-[11px] text-gray-500 hover:text-gray-900 mt-1"
                >
                  <span>@{dev.githubUsername}</span>
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              </div>
            </div>

            <!-- Bio -->
            {dev.bio && (
              <p class="text-xs text-gray-600 leading-relaxed mb-4">
                {dev.bio}
              </p>
            )}

            <!-- Contribution Tags -->
            <div class="flex flex-wrap gap-1.5 mb-4">
              {dev.contributions.map((tag) => (
                <span
                  class={
                    tag.toLowerCase().includes("editor")
                      ? "px-2.5 py-1 rounded-lg bg-gradient-to-r from-purple-50 to-brand-50 border border-purple-200 text-[10px] font-bold text-purple-800 shadow-2xs flex items-center gap-1"
                      : "px-2.5 py-1 rounded-lg bg-gray-50 border border-gray-200 text-[10px] font-medium text-gray-700"
                  }
                >
                  {tag.toLowerCase().includes("editor") && (
                    <span class="w-1.5 h-1.5 rounded-full bg-purple-500"></span>
                  )}
                  <span>{tag}</span>
                </span>
              ))}
            </div>
          </div>

          <!-- Footer Action -->
          <div class="pt-4 border-t border-gray-100 flex items-center justify-between text-xs">
            <a
              href={dev.github}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 font-semibold text-gray-800 hover:text-brand-600 transition-colors"
            >
              <span>View GitHub Profile</span>
              <span class="group-hover:translate-x-0.5 transition-transform">→</span>
            </a>
          </div>

        </div>
      ))}
    </div>

  </div>
</Layout>

<style>
  @keyframes floatContribute {
    0%, 100% {
      transform: translateY(0px) rotate(0deg);
    }
    50% {
      transform: translateY(-12px) rotate(1.5deg);
    }
  }

  @keyframes pulseGlow {
    0%, 100% {
      opacity: 0.35;
      transform: scale(0.95);
    }
    50% {
      opacity: 0.75;
      transform: scale(1.08);
    }
  }

  .animate-float-contribute {
    animation: floatContribute 5.5s ease-in-out infinite;
    will-change: transform;
  }

  .animate-pulse-glow {
    animation: pulseGlow 4s ease-in-out infinite;
    will-change: transform, opacity;
  }
</style>

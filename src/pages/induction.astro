---
import Layout from '../layouts/Layout.astro';
import { inductionEventData } from '../data/induction';
import { Image } from 'astro:assets';
import elementOne from '../assets/img/elementone.png';
import inductionHeroImg from '../assets/img/lnduction2026.png';

const nonTechTrack = inductionEventData.tracks.find(t => t.id === "non-technical")!;
const techTrack = inductionEventData.tracks.find(t => t.id === "technical")!;
---

<Layout
  title="Official Society Induction 2026 | The Speech Society (TSS)"
  description="Welcome to TSS Induction 2026 at UEM Jaipur: The Stage & Story Group Discussion Arena + Next-Gen Web Portfolio Workshop. Step Into the Arena: Mind + Voice."
>
  <div class="pt-36 sm:pt-44 md:pt-48 pb-28 sm:pb-36 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Hero Banner with Element One Graphic -->
    <div class="relative rounded-3xl bg-gradient-to-br from-blue-50/70 via-white to-purple-50/60 border border-gray-200 p-8 sm:p-12 lg:p-16 overflow-hidden shadow-lg mb-24 sm:mb-32">
      <div class="absolute -top-24 -left-24 w-80 h-80 bg-brand-500/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-24 -right-24 w-80 h-80 bg-purple-500/10 rounded-full blur-3xl pointer-events-none"></div>
      
      <div class="relative z-10 flex flex-col lg:flex-row items-center justify-between gap-12 lg:gap-14">
        <div class="max-w-2xl space-y-6 sm:space-y-8 text-left">
          
          <!-- Top Badge -->
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-100/80 border border-brand-200 text-brand-800 text-xs font-semibold uppercase tracking-wider">
            <span class="w-2 h-2 rounded-full bg-brand-600 animate-pulse"></span>
            <span>{inductionEventData.badge}</span>
          </div>

          <!-- Main Heading -->
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-display font-extrabold text-gray-900 tracking-tight leading-[1.1]">
            {inductionEventData.headline} <br />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-600 to-purple-600">
              {inductionEventData.highlightedHeadline}
            </span>
          </h1>

          <!-- Description -->
          <p class="text-base sm:text-lg text-gray-600 leading-relaxed">
            {inductionEventData.description}
          </p>

          <!-- 3 Information Cards -->
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 pt-2">
            <div class="p-4 rounded-2xl bg-white/80 border border-gray-200 shadow-xs">
              <span class="text-[10px] font-bold text-gray-400 uppercase tracking-wider block mb-1">Venue</span>
              <span class="text-xs sm:text-sm font-bold text-gray-900 leading-tight block">{inductionEventData.venue}</span>
            </div>
            <div class="p-4 rounded-2xl bg-white/80 border border-gray-200 shadow-xs">
              <span class="text-[10px] font-bold text-gray-400 uppercase tracking-wider block mb-1">Schedule</span>
              <span class="text-xs sm:text-sm font-bold text-gray-900 leading-tight block">{inductionEventData.schedule}</span>
            </div>
            <div class="p-4 rounded-2xl bg-white/80 border border-gray-200 shadow-xs col-span-2 sm:col-span-1">
              <span class="text-[10px] font-bold text-gray-400 uppercase tracking-wider block mb-1">Entry</span>
              <span class="text-xs sm:text-sm font-bold text-emerald-600 leading-tight block">{inductionEventData.entry}</span>
            </div>
          </div>

          <!-- Primary Action Buttons -->
          <div class="flex flex-wrap items-center gap-4 pt-4 sm:pt-6">
            <a
              href={inductionEventData.registrationLink}
              target="_blank"
              rel="noopener noreferrer"
              class="px-8 py-4 rounded-xl text-sm font-bold bg-gray-900 text-white hover:bg-gray-800 transition-all duration-200 shadow-lg hover:scale-[1.02] flex items-center gap-2"
            >
              <span>Register for Induction 2026 →</span>
            </a>

            <a
              href={inductionEventData.whatsappLink}
              target="_blank"
              rel="noopener noreferrer"
              class="px-6 py-4 rounded-xl text-sm font-bold bg-white border border-gray-300 text-gray-800 hover:text-black hover:border-brand-500 hover:bg-gray-50 shadow-sm transition-all duration-200 flex items-center gap-2"
            >
              <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.699c.971.53 1.771.815 2.796.815 3.183 0 5.769-2.587 5.77-5.766.001-3.182-2.585-5.77-5.77-5.801zm3.377 8.21c-.14.394-.712.753-1.042.802-.33.05-.758.077-2.317-.568-1.56-.645-2.55-2.222-2.628-2.327-.078-.105-.632-.841-.632-1.603 0-.762.399-1.137.541-1.293.142-.156.31-.195.413-.195.103 0 .207.001.298.006.095.005.223-.036.349.266.126.302.433 1.057.471 1.135.038.078.064.169.013.272-.051.103-.077.168-.154.258-.077.09-.163.2-.232.269-.078.078-.159.163-.068.319.091.156.404.667.868 1.08.597.531 1.101.696 1.257.774.156.078.247.068.338-.036.091-.104.389-.453.493-.608.104-.155.207-.129.349-.077.142.052.902.426 1.057.504.156.078.259.117.298.182.039.065.039.376-.101.77z"/>
              </svg>
              <span>Join WhatsApp Group</span>
            </a>
          </div>
        </div>

        <!-- Top Graphic (elementone.png) -->
        <div class="w-72 sm:w-80 md:w-96 lg:w-[380px] shrink-0 select-none pointer-events-none">
          <Image
            src={elementOne}
            alt="The Speech Society Graphic"
            class="w-full h-auto object-contain drop-shadow-2xl animate-float-slow"
            loading="eager"
          />
        </div>
      </div>
    </div>

    <!-- NON-TECHNICAL EVENT SECTION -->
    <div class="mb-24 sm:mb-32">
      <div class="max-w-3xl mb-10">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-50 border border-purple-200 text-purple-700 text-xs font-semibold uppercase tracking-wider mb-3">
          Non-Technical Event
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-extrabold text-gray-900 tracking-tight">
          The Stage & Story — Group Discussion & Debate Arena
        </h2>
        <div class="flex flex-wrap items-center gap-3 mt-3 text-sm font-semibold text-purple-700">
          <span class="px-3 py-1 rounded-lg bg-purple-50 border border-purple-200">1:00 – 2:40 PM</span>
          <span class="text-gray-600 font-normal">Target: BBA, BPT, B.Tech, BCA</span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-amber-50 border border-amber-200 text-amber-800 font-bold">
            <svg class="w-3.5 h-3.5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
            </svg>
            <span>Award: 1st Position</span>
          </span>
        </div>
      </div>

      <!-- Details & Rules Grid with Minimal SVG Icons -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <!-- Card 1 -->
        <div class="p-6 sm:p-8 rounded-3xl bg-white border border-gray-200 shadow-xs hover:border-purple-500/40 hover:shadow-md transition-all duration-300 flex flex-col justify-between group">
          <div>
            <div class="w-11 h-11 rounded-2xl bg-purple-50 border border-purple-100 text-purple-600 flex items-center justify-center mb-5 group-hover:scale-105 transition-transform">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
            </div>
            <h3 class="font-display font-bold text-lg text-gray-900 tracking-tight mb-2 group-hover:text-purple-600 transition-colors">Team Division</h3>
            <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">Participants are divided into collaborative teams of 6.</p>
          </div>
        </div>

        <!-- Card 2 -->
        <div class="p-6 sm:p-8 rounded-3xl bg-white border border-gray-200 shadow-xs hover:border-purple-500/40 hover:shadow-md transition-all duration-300 flex flex-col justify-between group">
          <div>
            <div class="w-11 h-11 rounded-2xl bg-purple-50 border border-purple-100 text-purple-600 flex items-center justify-center mb-5 group-hover:scale-105 transition-transform">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            </div>
            <h3 class="font-display font-bold text-lg text-gray-900 tracking-tight mb-2 group-hover:text-purple-600 transition-colors">Discussion Topics</h3>
            <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">Each team receives a unique thought-provoking discussion topic.</p>
          </div>
        </div>

        <!-- Card 3 -->
        <div class="p-6 sm:p-8 rounded-3xl bg-white border border-gray-200 shadow-xs hover:border-purple-500/40 hover:shadow-md transition-all duration-300 flex flex-col justify-between group">
          <div>
            <div class="w-11 h-11 rounded-2xl bg-purple-50 border border-purple-100 text-purple-600 flex items-center justify-center mb-5 group-hover:scale-105 transition-transform">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="font-display font-bold text-lg text-gray-900 tracking-tight mb-2 group-hover:text-purple-600 transition-colors">Speaking Time</h3>
            <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">Every participant gets approximately 2 minutes to express their thoughts.</p>
          </div>
        </div>

        <!-- Card 4 -->
        <div class="p-6 sm:p-8 rounded-3xl bg-white border border-gray-200 shadow-xs hover:border-purple-500/40 hover:shadow-md transition-all duration-300 flex flex-col justify-between group">
          <div>
            <div class="w-11 h-11 rounded-2xl bg-purple-50 border border-purple-100 text-purple-600 flex items-center justify-center mb-5 group-hover:scale-105 transition-transform">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <h3 class="font-display font-bold text-lg text-gray-900 tracking-tight mb-2 group-hover:text-purple-600 transition-colors">TSS Mentorship</h3>
            <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">Assigned TSS members observe groups and provide individual feedback.</p>
          </div>
        </div>

      </div>
    </div>

    <!-- TECHNICAL EVENT SECTION -->
    <div class="mb-24 sm:mb-32">
      <div class="max-w-3xl mb-10">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 border border-blue-200 text-blue-700 text-xs font-semibold uppercase tracking-wider mb-3">
          Technical Event
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-extrabold text-gray-900 tracking-tight">
          Next-Gen Web — Your First Portfolio Website
        </h2>
        <div class="flex flex-wrap items-center gap-3 mt-3 text-sm font-semibold text-blue-700">
          <span class="px-3 py-1 rounded-lg bg-blue-50 border border-blue-200">1:00 – 4:30 PM</span>
          <span class="text-gray-600 font-normal">Target: B.Tech, BCA</span>
          <span class="text-gray-700 font-normal">Introduction to Prompt Engineering & Web Workshop</span>
        </div>
      </div>

      <!-- Split Layout: Next-Gen Web Poster / Image + Modules Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- Left Column: Workshop Artwork Card (lnduction2026.png) -->
        <div class="lg:col-span-5 p-6 sm:p-8 rounded-3xl bg-gradient-to-br from-blue-50/70 via-white to-purple-50/60 border border-blue-200/70 shadow-xs flex flex-col justify-between">
          <div class="rounded-2xl overflow-hidden mb-6 shadow-md border border-blue-100 bg-white">
            <Image
              src={inductionHeroImg}
              alt="Next-Gen Web — Your First Portfolio Website"
              class="w-full h-auto object-contain hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
          </div>
          <div class="space-y-2">
            <span class="inline-block px-3 py-1 rounded-full bg-blue-100 text-blue-800 text-[10px] font-bold uppercase tracking-wider">
              Hands-on Build & Deploy
            </span>
            <h3 class="font-display font-bold text-xl text-gray-900 tracking-tight">
              Build Your Live Portfolio
            </h3>
            <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">
              Step-by-step mentoring from TSS web developers on crafting structured prompts, generating responsive components, and deploying your own live custom URL.
            </p>
          </div>
        </div>

        <!-- Right Column: Tech Workshop Points Grid -->
        <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-5">
          
          <!-- Point 1 -->
          <div class="p-6 rounded-3xl bg-white border border-gray-200 shadow-xs hover:shadow-md hover:border-blue-500/40 transition-all duration-300 flex flex-col justify-between group sm:col-span-2">
            <div>
              <div class="flex items-center justify-between mb-4">
                <div class="w-10 h-10 rounded-xl bg-blue-50 border border-blue-100 text-blue-600 flex items-center justify-center group-hover:scale-105 transition-transform">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <span class="w-7 h-7 rounded-xl bg-gray-100 border border-gray-200 text-gray-700 text-xs font-bold flex items-center justify-center font-mono">
                  01
                </span>
              </div>
              <h3 class="font-display font-bold text-base text-gray-900 tracking-tight mb-1 group-hover:text-blue-600 transition-colors">
                What is Prompt Engineering?
              </h3>
              <p class="text-xs text-gray-600 leading-relaxed">
                Understand how structured prompts, context framing, and system instructions unlock the full potential of Large Language Models.
              </p>
            </div>
          </div>

          <!-- Point 2 -->
          <div class="p-6 rounded-3xl bg-white border border-gray-200 shadow-xs hover:shadow-md hover:border-blue-500/40 transition-all duration-300 flex flex-col justify-between group">
            <div>
              <div class="flex items-center justify-between mb-4">
                <div class="w-10 h-10 rounded-xl bg-blue-50 border border-blue-100 text-blue-600 flex items-center justify-center group-hover:scale-105 transition-transform">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                  </svg>
                </div>
                <span class="w-7 h-7 rounded-xl bg-gray-100 border border-gray-200 text-gray-700 text-xs font-bold flex items-center justify-center font-mono">
                  02
                </span>
              </div>
              <h3 class="font-display font-bold text-base text-gray-900 tracking-tight mb-1 group-hover:text-blue-600 transition-colors">
                Why It Matters
              </h3>
              <p class="text-xs text-gray-600 leading-relaxed">
                In an AI-first world, architecting and steering code generation is a primary developer superpower.
              </p>
            </div>
          </div>

          <!-- Point 3 -->
          <div class="p-6 rounded-3xl bg-white border border-gray-200 shadow-xs hover:shadow-md hover:border-blue-500/40 transition-all duration-300 flex flex-col justify-between group">
            <div>
              <div class="flex items-center justify-between mb-4">
                <div class="w-10 h-10 rounded-xl bg-blue-50 border border-blue-100 text-blue-600 flex items-center justify-center group-hover:scale-105 transition-transform">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                  </svg>
                </div>
                <span class="w-7 h-7 rounded-xl bg-gray-100 border border-gray-200 text-gray-700 text-xs font-bold flex items-center justify-center font-mono">
                  03
                </span>
              </div>
              <h3 class="font-display font-bold text-base text-gray-900 tracking-tight mb-1 group-hover:text-blue-600 transition-colors">
                AI-Assisted Web
              </h3>
              <p class="text-xs text-gray-600 leading-relaxed">
                Learn how developers use modern AI workflows and frameworks to build web interfaces 10x faster.
              </p>
            </div>
          </div>

          <!-- Point 4 -->
          <div class="p-6 rounded-3xl bg-white border border-gray-200 shadow-xs hover:shadow-md hover:border-blue-500/40 transition-all duration-300 flex flex-col justify-between group">
            <div>
              <div class="flex items-center justify-between mb-4">
                <div class="w-10 h-10 rounded-xl bg-blue-50 border border-blue-100 text-blue-600 flex items-center justify-center group-hover:scale-105 transition-transform">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
                  </svg>
                </div>
                <span class="w-7 h-7 rounded-xl bg-gray-100 border border-gray-200 text-gray-700 text-xs font-bold flex items-center justify-center font-mono">
                  04
                </span>
              </div>
              <h3 class="font-display font-bold text-base text-gray-900 tracking-tight mb-1 group-hover:text-blue-600 transition-colors">
                Why You Need a Portfolio
              </h3>
              <p class="text-xs text-gray-600 leading-relaxed">
                A personal website is your living digital proof-of-work, replacing static resumes with interactive projects.
              </p>
            </div>
          </div>

          <!-- Point 5 -->
          <div class="p-6 rounded-3xl bg-white border border-gray-200 shadow-xs hover:shadow-md hover:border-blue-500/40 transition-all duration-300 flex flex-col justify-between group">
            <div>
              <div class="flex items-center justify-between mb-4">
                <div class="w-10 h-10 rounded-xl bg-blue-50 border border-blue-100 text-blue-600 flex items-center justify-center group-hover:scale-105 transition-transform">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <span class="w-7 h-7 rounded-xl bg-gray-100 border border-gray-200 text-gray-700 text-xs font-bold flex items-center justify-center font-mono">
                  05
                </span>
              </div>
              <h3 class="font-display font-bold text-base text-gray-900 tracking-tight mb-1 group-hover:text-blue-600 transition-colors">
                Career & Placement Boost
              </h3>
              <p class="text-xs text-gray-600 leading-relaxed">
                Stand out in tech internships, campus placements, freelancing, and personal branding.
              </p>
            </div>
          </div>

        </div>

      </div>
    </div>

    <!-- Bottom Sticky Register Callout Banner -->
    <div class="rounded-3xl bg-gray-900 text-white p-8 sm:p-14 lg:p-16 shadow-2xl relative overflow-hidden text-center">
      <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-96 h-96 bg-brand-500/20 rounded-full blur-3xl pointer-events-none"></div>
      
      <div class="relative z-10 max-w-2xl mx-auto space-y-6">
        <span class="inline-block px-3.5 py-1.5 rounded-full bg-white/10 text-brand-300 text-xs font-semibold uppercase tracking-wider">
          Limited Seats • Register Early
        </span>
        
        <h2 class="text-3xl sm:text-4xl font-display font-extrabold tracking-tight">
          Ready to Step Into the Arena?
        </h2>
        
        <p class="text-sm sm:text-base text-gray-300 leading-relaxed">
          Fill out the official registration form to secure your seat for The Speech Society Induction 2026.
        </p>

        <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
          <a
            href={inductionEventData.registrationLink}
            target="_blank"
            rel="noopener noreferrer"
            class="px-8 py-4 rounded-xl text-sm font-bold bg-white text-gray-950 hover:bg-gray-100 transition-all duration-200 shadow-lg hover:scale-[1.02]"
          >
            Register for Induction 2026 →
          </a>
          <a
            href={inductionEventData.whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="px-8 py-4 rounded-xl text-sm font-bold bg-white/10 border border-white/20 text-white hover:bg-white/20 transition-all duration-200"
          >
            Join WhatsApp Group
          </a>
        </div>
      </div>
    </div>

  </div>
</Layout>

<style>
  @keyframes floatSlow {
    0%, 100% {
      transform: translateY(0px) rotate(0deg);
    }
    50% {
      transform: translateY(-10px) rotate(1.5deg);
    }
  }

  .animate-float-slow {
    animation: floatSlow 6s ease-in-out infinite;
    will-change: transform;
  }
</style>
